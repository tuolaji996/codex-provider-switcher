<Window x:Class="CodexProviderSwitcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex Provider Switcher"
        Width="880"
        Height="760"
        MinWidth="680"
        MinHeight="520"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterScreen">
    <ScrollViewer x:Name="MainScrollViewer"
                  Background="{StaticResource WindowBrush}"
                  VerticalScrollBarVisibility="Auto">
        <Grid Margin="34" Background="{StaticResource WindowBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="52"
                        Height="52"
                        CornerRadius="14"
                        Background="#183A2C"
                        Margin="0,0,16,0">
                    <Viewbox Margin="12">
                        <Canvas Width="28" Height="28">
                            <Path Stroke="{StaticResource AccentBrush}"
                                  StrokeThickness="3"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Data="M 3,9 L 21,9 M 16,4 L 21,9 L 16,14 M 25,19 L 7,19 M 12,14 L 7,19 L 12,24" />
                        </Canvas>
                    </Viewbox>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Codex Provider Switcher"
                               FontSize="25"
                               FontWeight="SemiBold"
                               Margin="0,0,8,0"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="TaglineText"
                               Text="官方登录与第三方线路，共用同一份聊天历史"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="13"
                               Margin="0,4,8,0"
                               TextWrapping="Wrap" />
                </StackPanel>
                <Border Grid.Column="2"
                        CornerRadius="8"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        Background="#101720"
                        Padding="2"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <ToggleButton x:Name="ChineseLanguageButton"
                                      Content="CHN"
                                      Style="{StaticResource LanguageButton}"
                                      Margin="0,0,2,0"
                                      IsEnabled="False"
                                      Checked="ChineseLanguageButton_Checked"
                                      Unchecked="LanguageButton_Unchecked" />
                        <ToggleButton x:Name="EnglishLanguageButton"
                                      Content="ENG"
                                      Style="{StaticResource LanguageButton}"
                                      IsEnabled="False"
                                      Checked="EnglishLanguageButton_Checked"
                                      Unchecked="LanguageButton_Unchecked" />
                    </StackPanel>
                </Border>
                <Border x:Name="ModeBadge"
                        Grid.Column="3"
                        CornerRadius="16"
                        Padding="13,7"
                        Background="#26313E"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="ModeBadgeText"
                               Text="正在检测"
                               FontWeight="SemiBold"
                               FontSize="12" />
                </Border>
            </Grid>

            <Border Grid.Row="1"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="20"
                    Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="CurrentStatusTitleText"
                                   Text="当前状态"
                                   FontSize="15"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="CurrentRouteText"
                                   Margin="0,7,0,0"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="HistoryStatusText"
                                   Margin="0,7,0,0"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="StableHistoryText"
                                   Text="固定历史分区：OpenAI（切换时永远不改）"
                                   Margin="0,7,0,0"
                                   Foreground="{StaticResource AccentBrush}" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            x:Name="OpenBackupsButton"
                            Content="打开备份"
                            Style="{StaticResource SecondaryButton}"
                            Margin="18,0,0,0"
                            VerticalAlignment="Center"
                            Click="OpenBackupsButton_Click" />
                </Grid>
            </Border>

            <Border Grid.Row="2"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="20"
                    Margin="0,0,0,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,16">
                        <TextBlock x:Name="ThirdPartyTitleText"
                                   Text="第三方线路"
                                   FontSize="17"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="KeyStorageDescriptionText"
                                   Text="密钥保存在 Windows 凭据管理器；不会写进 config.toml、源码或日志。"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Margin="0,5,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <TextBlock x:Name="BaseUrlLabelText"
                               Grid.Row="1"
                               Grid.Column="0"
                               Text="Base URL"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource MutedTextBrush}" />
                    <TextBox Grid.Row="1"
                             Grid.Column="1"
                             x:Name="BaseUrlTextBox"
                             AutomationProperties.LabeledBy="{Binding ElementName=BaseUrlLabelText}"
                             TextChanged="ProviderSettingsTextBox_TextChanged"
                             Margin="0,0,0,11" />

                    <TextBlock x:Name="ModelLabelText"
                               Grid.Row="2"
                               Grid.Column="0"
                               Text="模型"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource MutedTextBrush}" />
                    <TextBox Grid.Row="2"
                             Grid.Column="1"
                             x:Name="ModelTextBox"
                             AutomationProperties.LabeledBy="{Binding ElementName=ModelLabelText}"
                             TextChanged="ProviderSettingsTextBox_TextChanged"
                             Margin="0,0,0,11" />

                    <TextBlock x:Name="ApiKeyLabelText"
                               Grid.Row="3"
                               Grid.Column="0"
                               Text="新 API Key"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource MutedTextBrush}" />
                    <Grid Grid.Row="3" Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <PasswordBox x:Name="ApiKeyPasswordBox"
                                     AutomationProperties.LabeledBy="{Binding ElementName=ApiKeyLabelText}" />
                        <Button Grid.Column="1"
                                x:Name="SaveKeyButton"
                                Content="保存密钥"
                                Style="{StaticResource SecondaryButton}"
                                Margin="10,0,0,0"
                                Click="SaveKeyButton_Click" />
                        <Button Grid.Column="2"
                                x:Name="DeleteKeyButton"
                                Content="删除"
                                Style="{StaticResource SecondaryButton}"
                                Margin="8,0,0,0"
                                Click="DeleteKeyButton_Click" />
                    </Grid>

                    <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Margin="0,16,0,0">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="KeyStatusText"
                                       Foreground="{StaticResource MutedTextBrush}" />
                            <TextBlock x:Name="ThirdPartyPrivacyWarningText"
                                       Text="注意：第三方服务会接收你发送给 Codex 的提示词、代码片段和工具上下文。"
                                       Foreground="#E9A23B"
                                       FontSize="12"
                                       Margin="0,4,16,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <WrapPanel HorizontalAlignment="Right" Margin="0,12,0,0">
                            <Button x:Name="TestConnectionButton"
                                    Content="测试 Responses 兼容性"
                                    Style="{StaticResource SecondaryButton}"
                                    Margin="0,0,10,8"
                                    Click="TestConnectionButton_Click" />
                            <Button x:Name="SwitchThirdPartyButton"
                                    Content="切换到第三方"
                                    Style="{StaticResource PrimaryButton}"
                                    Margin="0,0,0,8"
                                    Click="SwitchThirdPartyButton_Click" />
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="3"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="20"
                    Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock x:Name="CapabilityTitleText"
                               Text="能力诊断"
                               FontSize="17"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="CapabilityDescriptionText"
                               Text="官方账号能力保留在本机；第三方模型仍需通过 Responses 工具协议与图片接口实测。"
                               Foreground="{StaticResource MutedTextBrush}"
                               Margin="0,5,0,0"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="HostCapabilityStatusText"
                               Foreground="{StaticResource MutedTextBrush}"
                               Margin="0,13,0,0"
                               Text="官方登录与功能开关：正在检测…"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="ToolCapabilityStatusText"
                               Foreground="{StaticResource MutedTextBrush}"
                               Margin="0,7,0,0"
                               Text="第三方插件工具调用：尚未实测"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="ImageCapabilityStatusText"
                               Foreground="{StaticResource MutedTextBrush}"
                               Margin="0,7,0,0"
                               Text="第三方图片生成：尚未实测"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="RemoteCapabilityStatusText"
                               Foreground="{StaticResource MutedTextBrush}"
                               Margin="0,7,0,0"
                               Text="手机 Remote：需使用相同 ChatGPT 账号在官方 Connections 页面扫码配对"
                               TextWrapping="Wrap" />
                    <WrapPanel Margin="0,15,0,0">
                        <Button x:Name="RefreshCapabilitiesButton"
                                Content="刷新官方能力"
                                Style="{StaticResource SecondaryButton}"
                                Margin="0,0,8,8"
                                Click="RefreshCapabilitiesButton_Click" />
                        <Button x:Name="TestToolCallingButton"
                                Content="测试插件工具调用"
                                Style="{StaticResource SecondaryButton}"
                                Margin="0,0,8,8"
                                Click="TestToolCallingButton_Click" />
                        <Button x:Name="TestImageGenerationButton"
                                Content="生成测试图片"
                                Style="{StaticResource SecondaryButton}"
                                Margin="0,0,8,8"
                                Click="TestImageGenerationButton_Click" />
                        <Button x:Name="OpenGeneratedImageButton"
                                Content="打开测试图片"
                                Style="{StaticResource SecondaryButton}"
                                Margin="0,0,8,8"
                                IsEnabled="False"
                                Click="OpenGeneratedImageButton_Click" />
                        <Button x:Name="OpenRemoteSettingsButton"
                                Content="打开 Remote 设置"
                                Style="{StaticResource PrimaryButton}"
                                Margin="0,0,0,8"
                                Click="OpenRemoteSettingsButton_Click" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Grid.Row="4"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="20"
                    Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="OfficialTitleText"
                                   Text="官方 OpenAI Codex"
                                   FontSize="17"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="OfficialDescriptionText"
                                   Text="使用现有 ChatGPT 登录与订阅额度；官方登录凭据不会被删除或覆盖。"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Margin="0,6,20,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            x:Name="SwitchOfficialButton"
                            Content="切换到官方"
                            Style="{StaticResource OfficialButton}"
                            VerticalAlignment="Center"
                            Click="SwitchOfficialButton_Click" />
                </Grid>
            </Border>

            <Border Grid.Row="5"
                    Background="#101720"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <CheckBox x:Name="RestartCheckBox"
                              VerticalAlignment="Top"
                              Margin="0,3,11,0"
                              Checked="RestartCheckBox_Changed"
                              Unchecked="RestartCheckBox_Changed" />
                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="RestartTitleText"
                                   Text="切换后自动重启 Codex"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="RestartDescriptionText"
                                   Text="重启会中断正在运行的 Codex 任务。配置写入前会自动生成备份。"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Margin="0,3,0,0"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="OperationStatusText"
                                   Foreground="{StaticResource AccentBrush}"
                                   Margin="0,9,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Window>
