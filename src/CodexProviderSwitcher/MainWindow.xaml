<Window x:Class="CodexProviderSwitcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex Provider Switcher"
        Width="1020"
        Height="720"
        MinWidth="680"
        MinHeight="520"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextBrush}"
        WindowStartupLocation="CenterScreen">
    <Grid Background="{DynamicResource WindowBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="NavigationColumn" Width="210" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{DynamicResource NavigationBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid Margin="12,16,12,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="54" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid x:Name="NavigationBrand" Margin="8,0,8,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="34"
                            Height="34"
                            CornerRadius="6"
                            Background="{DynamicResource AccentBrush}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center">
                        <TextBlock Text="&#xE8AB;"
                                   FontFamily="{StaticResource IconFont}"
                                   Foreground="{DynamicResource AccentForegroundBrush}"
                                   FontSize="17"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel x:Name="NavigationBrandText"
                                Grid.Column="1"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center">
                        <TextBlock Text="Codex Switcher"
                                   FontSize="14"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="NavigationSubtitleText"
                                   Text="供应商控制台"
                                   Foreground="{DynamicResource SubtleTextBrush}"
                                   FontSize="10"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="1" Margin="0,4,0,0">
                    <RadioButton x:Name="HomeNavigationButton"
                                 GroupName="Navigation"
                                 Tag="&#xE80F;"
                                 Style="{StaticResource NavigationItemStyle}"
                                 ToolTip="首页"
                                 Checked="NavigationButton_Checked">
                        <TextBlock x:Name="HomeNavigationText" Text="首页" />
                    </RadioButton>
                    <RadioButton x:Name="ProvidersNavigationButton"
                                 GroupName="Navigation"
                                 Tag="&#xE8AB;"
                                 Style="{StaticResource NavigationItemStyle}"
                                 ToolTip="供应商"
                                 Checked="NavigationButton_Checked">
                        <TextBlock x:Name="ProvidersNavigationText" Text="供应商" />
                    </RadioButton>
                    <RadioButton x:Name="DiagnosticsNavigationButton"
                                 GroupName="Navigation"
                                 Tag="&#xE9D9;"
                                 Style="{StaticResource NavigationItemStyle}"
                                 ToolTip="能力诊断"
                                 Checked="NavigationButton_Checked">
                        <TextBlock x:Name="DiagnosticsNavigationText" Text="能力诊断" />
                    </RadioButton>
                    <RadioButton x:Name="BackupsNavigationButton"
                                 GroupName="Navigation"
                                 Tag="&#xE8B7;"
                                 Style="{StaticResource NavigationItemStyle}"
                                 ToolTip="备份记录"
                                 Checked="NavigationButton_Checked">
                        <TextBlock x:Name="BackupsNavigationText" Text="备份记录" />
                    </RadioButton>
                </StackPanel>

                <RadioButton x:Name="SettingsNavigationButton"
                             Grid.Row="2"
                             GroupName="Navigation"
                             Tag="&#xE713;"
                             Style="{StaticResource NavigationItemStyle}"
                             ToolTip="设置"
                             Checked="NavigationButton_Checked">
                    <TextBlock x:Name="SettingsNavigationText" Text="设置" />
                </RadioButton>

                <Border Grid.Row="3"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,1,0,0"
                        Margin="8,10,8,0"
                        Padding="0,12,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="ProviderStatusDot"
                                Width="8"
                                Height="8"
                                CornerRadius="4"
                                Background="{DynamicResource NeutralStatusBrush}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center" />
                        <TextBlock x:Name="NavStatusText"
                                   Grid.Column="1"
                                   Text="正在检测"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   FontSize="10"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="VersionText"
                                   Grid.Column="2"
                                   Text="v1.3.3"
                                   Foreground="{DynamicResource SubtleTextBrush}"
                                   FontSize="10"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Background="{DynamicResource WindowBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="68" />
                <RowDefinition Height="*" />
                <RowDefinition Height="40" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource NavigationBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid Margin="28,0,20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PageTitleText"
                               Text="首页"
                               FontSize="21"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <Button x:Name="HeaderRefreshButton"
                            Grid.Column="1"
                            Tag="&#xE72C;"
                            ToolTip="刷新状态"
                            AutomationProperties.Name="刷新状态"
                            Style="{StaticResource IconButtonStyle}"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            Click="HeaderRefreshButton_Click" />
                    <Border x:Name="ModeBadge"
                            Grid.Column="2"
                            CornerRadius="5"
                            Padding="11,6"
                            Background="{DynamicResource NeutralStatusBrush}"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="ModeBadgeText"
                                   Text="正在检测"
                                   Foreground="{DynamicResource StatusBadgeForegroundBrush}"
                                   FontWeight="SemiBold"
                                   FontSize="11" />
                    </Border>
                </Grid>
            </Border>

            <ScrollViewer x:Name="MainScrollViewer"
                          Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <Grid x:Name="HomePage"
                      Margin="28,24,28,30"
                      MaxWidth="980"
                      HorizontalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="TaglineText"
                               Grid.Row="0"
                               Text="官方登录与第三方线路，共用同一份聊天历史。"
                               Style="{StaticResource PageLeadStyle}"
                               Margin="0,0,0,20" />

                    <Border Grid.Row="1"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="20"
                            Margin="0,0,0,18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="CurrentStatusTitleText"
                                           Text="当前线路"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource MutedTextBrush}" />
                                <TextBlock x:Name="CurrentRouteText"
                                           Margin="0,6,18,0"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>
                            <Button x:Name="DailyPrimaryActionButton"
                                    Grid.Column="1"
                                    Content="正在检测"
                                    Tag="&#xE72C;"
                                    Style="{StaticResource PrimaryButton}"
                                    VerticalAlignment="Center"
                                    Click="DailyPrimaryActionButton_Click" />
                            <StackPanel Grid.Row="1"
                                        Grid.ColumnSpan="2"
                                        Margin="0,18,0,0">
                                <Border Height="1"
                                        Background="{DynamicResource BorderBrush}"
                                        Margin="0,0,0,14" />
                                <TextBlock x:Name="HistoryStatusText"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           TextWrapping="Wrap"
                                           AutomationProperties.LiveSetting="Polite" />
                                <TextBlock x:Name="StableHistoryText"
                                           Text="固定历史分区：OpenAI（切换时永远不改）"
                                           Margin="0,6,0,0"
                                           Foreground="{DynamicResource AccentBrush}"
                                           FontSize="12"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid x:Name="HomeSafetyPanel"
                          Grid.Row="2"
                          Margin="0,0,0,22"
                          Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="HomeSafetyTitleText"
                                   Text="本机保护"
                                   Style="{StaticResource SectionTitleStyle}" />
                        <Border Grid.Row="1"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE72E;"
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="16"
                                           Foreground="{DynamicResource OfficialStatusBrush}"
                                           VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock x:Name="OfficialAuthSafetyTitleText"
                                               Text="官方登录保持不变"
                                               FontWeight="SemiBold"
                                               FontSize="13" />
                                    <TextBlock x:Name="OfficialAuthSafetyDescriptionText"
                                               Text="切换第三方时不会删除或覆盖 ChatGPT 登录。"
                                               Style="{StaticResource PageLeadStyle}"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Grid.Row="2"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE8D7;"
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="16"
                                           Foreground="{DynamicResource AccentBrush}"
                                           VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock x:Name="HistorySafetyTitleText"
                                               Text="聊天记录不搬家"
                                               FontWeight="SemiBold"
                                               FontSize="13" />
                                    <TextBlock x:Name="HistorySafetyDescriptionText"
                                               Text="两条线路都使用稳定的 OpenAI 历史分区。"
                                               Style="{StaticResource PageLeadStyle}"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Grid.Row="3" Padding="0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE8B7;"
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="16"
                                           Foreground="{DynamicResource WarningBrush}"
                                           VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock x:Name="BackupSafetyTitleText"
                                               Text="每次写入先备份"
                                               FontWeight="SemiBold"
                                               FontSize="13" />
                                    <TextBlock x:Name="BackupSafetyDescriptionText"
                                               Text="config.toml 会在切换前创建带时间戳的副本。"
                                               Style="{StaticResource PageLeadStyle}"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <WrapPanel Grid.Row="3" Visibility="Collapsed">
                        <Button x:Name="HomeOpenProvidersButton"
                                Content="管理供应商"
                                Tag="&#xE8AB;"
                                Style="{StaticResource SecondaryButton}"
                                Margin="0,0,8,8"
                                Click="HomeOpenProvidersButton_Click" />
                        <Button x:Name="HomeOpenDiagnosticsButton"
                                Content="查看能力诊断"
                                Tag="&#xE9D9;"
                                Style="{StaticResource SecondaryButton}"
                                Margin="0,0,8,8"
                                Click="HomeOpenDiagnosticsButton_Click" />
                        <Button x:Name="OpenBackupsButton"
                                Content="查看备份"
                                Tag="&#xE8B7;"
                                Style="{StaticResource SecondaryButton}"
                                Margin="0,0,0,8"
                                Click="OpenBackupsButton_Click" />
                    </WrapPanel>
                </Grid>
            </ScrollViewer>

            <ScrollViewer x:Name="ProvidersPageScrollViewer"
                          Grid.Row="1"
                          Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <Grid x:Name="ProvidersPage"
                      Margin="28,24,28,30"
                      MaxWidth="980"
                      HorizontalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="ProvidersLeadText"
                               Grid.Row="0"
                               Text="选择线路并管理第三方 Responses API。切换不会改变聊天历史分区。"
                               Style="{StaticResource PageLeadStyle}"
                               Margin="0,0,0,18" />

                    <Border Grid.Row="1"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="0,4,0,20"
                            Margin="0,0,0,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,20,0">
                                <TextBlock x:Name="OfficialTitleText"
                                           Text="官方 OpenAI Codex"
                                           Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock x:Name="OfficialDescriptionText"
                                           Text="使用现有 ChatGPT 登录与订阅额度；官方凭据不会被删除或覆盖。"
                                           Style="{StaticResource PageLeadStyle}" />
                            </StackPanel>
                            <Button x:Name="SwitchOfficialButton"
                                    Grid.Column="1"
                                    Content="切换到官方"
                                    Tag="&#xE72E;"
                                    Style="{StaticResource OfficialButton}"
                                    VerticalAlignment="Center"
                                    Click="SwitchOfficialButton_Click" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="ThirdPartyTitleText"
                                   Text="第三方线路"
                                   Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock x:Name="KeyStorageDescriptionText"
                                   Grid.Row="1"
                                   Text="密钥保存在 Windows 凭据管理器；不会写进 config.toml、源码或日志。"
                                   Style="{StaticResource PageLeadStyle}"
                                   Margin="0,0,0,16" />

                        <Grid Grid.Row="2" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="132" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="BaseUrlLabelText"
                                       Text="Base URL"
                                       Style="{StaticResource FieldLabelStyle}" />
                            <TextBox x:Name="BaseUrlTextBox"
                                     Grid.Column="1"
                                     AutomationProperties.LabeledBy="{Binding ElementName=BaseUrlLabelText}"
                                     TextChanged="ProviderSettingsTextBox_TextChanged" />
                        </Grid>

                        <Grid Grid.Row="3" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="132" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ModelLabelText"
                                       Text="模型"
                                       Style="{StaticResource FieldLabelStyle}" />
                            <TextBox x:Name="ModelTextBox"
                                     Grid.Column="1"
                                     AutomationProperties.LabeledBy="{Binding ElementName=ModelLabelText}"
                                     TextChanged="ProviderSettingsTextBox_TextChanged" />
                        </Grid>

                        <Grid Grid.Row="4" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="132" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ApiKeyLabelText"
                                       Text="新 API Key"
                                       Style="{StaticResource FieldLabelStyle}"
                                       VerticalAlignment="Top"
                                       Margin="0,10,0,0" />
                            <StackPanel Grid.Column="1">
                                <PasswordBox x:Name="ApiKeyPasswordBox"
                                             AutomationProperties.LabeledBy="{Binding ElementName=ApiKeyLabelText}" />
                                <WrapPanel Margin="0,8,0,0">
                                    <Button x:Name="SaveKeyButton"
                                            Content="保存密钥"
                                            Tag="&#xE74E;"
                                            Style="{StaticResource SecondaryButton}"
                                            Margin="0,0,8,8"
                                            Click="SaveKeyButton_Click" />
                                    <Button x:Name="DeleteKeyButton"
                                            Content="删除密钥"
                                            Tag="&#xE74D;"
                                            Style="{StaticResource DangerButton}"
                                            Margin="0,0,0,8"
                                            Click="DeleteKeyButton_Click" />
                                </WrapPanel>
                                <TextBlock x:Name="KeyStatusText"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="5"
                                Background="{DynamicResource WarningSurfaceBrush}"
                                BorderBrush="{DynamicResource WarningBrush}"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="12"
                                Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE7BA;"
                                           FontFamily="{StaticResource IconFont}"
                                           Foreground="{DynamicResource WarningBrush}"
                                           FontSize="15"
                                           VerticalAlignment="Top" />
                                <TextBlock x:Name="ThirdPartyPrivacyWarningText"
                                           Grid.Column="1"
                                           Text="第三方服务会接收你发送给 Codex 的提示词、代码片段和工具上下文。"
                                           Foreground="{DynamicResource WarningBrush}"
                                           FontSize="12"
                                           TextWrapping="Wrap" />
                            </Grid>
                        </Border>
                    </Grid>

                    <WrapPanel Grid.Row="3" HorizontalAlignment="Right">
                        <Button x:Name="TestConnectionButton"
                                Content="测试 Responses 兼容性"
                                Tag="&#xE9D9;"
                                Style="{StaticResource SecondaryButton}"
                                Margin="0,0,8,8"
                                Click="TestConnectionButton_Click" />
                        <Button x:Name="SwitchThirdPartyButton"
                                Content="切换到第三方"
                                Tag="&#xE8AB;"
                                Style="{StaticResource PrimaryButton}"
                                Margin="0,0,0,8"
                                Click="SwitchThirdPartyButton_Click" />
                    </WrapPanel>
                </Grid>
            </ScrollViewer>

            <ScrollViewer x:Name="DiagnosticsPageScrollViewer"
                          Grid.Row="1"
                          Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <Grid x:Name="DiagnosticsPage"
                      Margin="28,24,28,30"
                      MaxWidth="980"
                      HorizontalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock x:Name="CapabilityTitleText"
                                   Text="能力诊断"
                                   Visibility="Collapsed" />
                        <TextBlock x:Name="CapabilityDescriptionText"
                                   Text="官方账号能力保留在本机；第三方模型仍需通过 Responses 工具协议与图片接口实测。"
                                   Style="{StaticResource PageLeadStyle}" />
                    </StackPanel>

                    <Border Grid.Row="1"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="HostStatusDot"
                                    Width="9"
                                    Height="9"
                                    CornerRadius="5"
                                    Background="{DynamicResource NeutralStatusBrush}"
                                    Margin="0,5,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top" />
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="HostDiagnosticTitleText"
                                           Text="官方宿主"
                                           FontWeight="SemiBold"
                                           FontSize="14" />
                                <TextBlock x:Name="HostCapabilityStatusText"
                                           Text="官方登录与功能开关：正在检测…"
                                           Style="{StaticResource PageLeadStyle}"
                                           Margin="0,5,0,0"
                                           AutomationProperties.LiveSetting="Polite" />
                                <WrapPanel Margin="0,10,0,0">
                                    <Button x:Name="RefreshCapabilitiesButton"
                                            Content="刷新官方能力"
                                            Tag="&#xE72C;"
                                            Style="{StaticResource SecondaryButton}"
                                            Click="RefreshCapabilitiesButton_Click" />
                                </WrapPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="ToolStatusDot"
                                    Width="9"
                                    Height="9"
                                    CornerRadius="5"
                                    Background="{DynamicResource NeutralStatusBrush}"
                                    Margin="0,5,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top" />
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="ToolDiagnosticTitleText"
                                           Text="插件工具协议"
                                           FontWeight="SemiBold"
                                           FontSize="14" />
                                <TextBlock x:Name="ToolCapabilityStatusText"
                                           Text="第三方插件工具调用：尚未实测"
                                           Style="{StaticResource PageLeadStyle}"
                                           Margin="0,5,0,0"
                                           AutomationProperties.LiveSetting="Polite" />
                                <WrapPanel Margin="0,10,0,0">
                                    <Button x:Name="TestToolCallingButton"
                                            Content="测试插件工具调用"
                                            Tag="&#xE8D4;"
                                            Style="{StaticResource SecondaryButton}"
                                            Click="TestToolCallingButton_Click" />
                                </WrapPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="3"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="ImageStatusDot"
                                    Width="9"
                                    Height="9"
                                    CornerRadius="5"
                                    Background="{DynamicResource NeutralStatusBrush}"
                                    Margin="0,5,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top" />
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="ImageDiagnosticTitleText"
                                           Text="图片生成"
                                           FontWeight="SemiBold"
                                           FontSize="14" />
                                <TextBlock x:Name="ImageCapabilityStatusText"
                                           Text="第三方图片生成：尚未实测"
                                           Style="{StaticResource PageLeadStyle}"
                                           Margin="0,5,0,0"
                                           AutomationProperties.LiveSetting="Polite" />
                                <WrapPanel Margin="0,10,0,0">
                                    <Button x:Name="TestImageGenerationButton"
                                            Content="生成测试图片"
                                            Tag="&#xEB9F;"
                                            Style="{StaticResource SecondaryButton}"
                                            Margin="0,0,8,8"
                                            Click="TestImageGenerationButton_Click" />
                                    <Button x:Name="OpenGeneratedImageButton"
                                            Content="打开测试图片"
                                            Tag="&#xE8A7;"
                                            Style="{StaticResource SecondaryButton}"
                                            Margin="0,0,0,8"
                                            IsEnabled="False"
                                            Click="OpenGeneratedImageButton_Click" />
                                </WrapPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="4" Padding="0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="RemoteStatusDot"
                                    Width="9"
                                    Height="9"
                                    CornerRadius="5"
                                    Background="{DynamicResource NeutralStatusBrush}"
                                    Margin="0,5,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top" />
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="RemoteDiagnosticTitleText"
                                           Text="手机 Remote（本机前置条件）"
                                           FontWeight="SemiBold"
                                           FontSize="14" />
                                <TextBlock x:Name="RemoteCapabilityStatusText"
                                           Text="需使用相同 ChatGPT 账号在官方 Connections 页面完成配对。"
                                           Style="{StaticResource PageLeadStyle}"
                                           Margin="0,5,0,0"
                                           AutomationProperties.LiveSetting="Polite" />
                                <WrapPanel Margin="0,10,0,0">
                                    <Button x:Name="OpenRemoteSettingsButton"
                                            Content="打开 Connections"
                                            Tag="&#xE8EA;"
                                            Style="{StaticResource PrimaryButton}"
                                            Click="OpenRemoteSettingsButton_Click" />
                                </WrapPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </ScrollViewer>

            <Grid x:Name="BackupsPage"
                  Grid.Row="1"
                  Visibility="Collapsed"
                  Margin="28,24,28,28"
                  MaxWidth="980"
                  HorizontalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="BackupsLeadText"
                           Text="每次切换前创建的 config.toml 备份副本。"
                           Style="{StaticResource PageLeadStyle}"
                           Margin="0,0,0,14" />
                <Grid Grid.Row="1" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="BackupCountText"
                               Text="0 个备份"
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="12"
                               VerticalAlignment="Center" />
                    <WrapPanel Grid.Column="1">
                        <Button x:Name="RefreshBackupsButton"
                                Content="刷新"
                                Tag="&#xE72C;"
                                Style="{StaticResource SecondaryButton}"
                                Margin="0,0,8,0"
                                Click="RefreshBackupsButton_Click" />
                        <Button x:Name="OpenSelectedBackupButton"
                                Content="打开所选位置"
                                Tag="&#xE838;"
                                Style="{StaticResource SecondaryButton}"
                                Margin="0,0,8,0"
                                IsEnabled="False"
                                Click="OpenSelectedBackupButton_Click" />
                        <Button x:Name="OpenBackupFolderButton"
                                Content="打开备份文件夹"
                                Tag="&#xE8B7;"
                                Style="{StaticResource PrimaryButton}"
                                Click="OpenBackupFolderButton_Click" />
                    </WrapPanel>
                </Grid>
                <Grid Grid.Row="2">
                    <DataGrid x:Name="BackupsDataGrid"
                              AutoGenerateColumns="False"
                              AlternationCount="2"
                              SelectionChanged="BackupsDataGrid_SelectionChanged"
                              MouseDoubleClick="BackupsDataGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn x:Name="BackupTimeColumn"
                                                Header="时间"
                                                Binding="{Binding DisplayTime}"
                                                SortMemberPath="Timestamp"
                                                Width="150" />
                            <DataGridTextColumn x:Name="BackupSizeColumn"
                                                Header="大小"
                                                Binding="{Binding DisplaySize}"
                                                SortMemberPath="SizeBytes"
                                                Width="85" />
                            <DataGridTextColumn x:Name="BackupFolderColumn"
                                                Header="备份 ID"
                                                Binding="{Binding FolderName}"
                                                Width="165" />
                            <DataGridTextColumn x:Name="BackupPathColumn"
                                                Header="文件"
                                                Binding="{Binding ConfigPath}"
                                                Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel x:Name="BackupsEmptyPanel"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <TextBlock Text="&#xE8B7;"
                                   FontFamily="{StaticResource IconFont}"
                                   FontSize="30"
                                   Foreground="{DynamicResource SubtleTextBrush}"
                                   HorizontalAlignment="Center" />
                        <TextBlock x:Name="BackupsEmptyText"
                                   Text="还没有备份"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   FontSize="13"
                                   Margin="0,8,0,0" />
                    </StackPanel>
                </Grid>
            </Grid>

            <ScrollViewer x:Name="SettingsPageScrollViewer"
                          Grid.Row="1"
                          Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <Grid x:Name="SettingsPage"
                      Margin="28,24,28,30"
                      MaxWidth="980"
                      HorizontalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="SettingsLeadText"
                                   Text="界面与切换行为会保存在本机，不会改动聊天记录。"
                                   Style="{StaticResource PageLeadStyle}"
                                   Margin="0,0,16,0" />
                        <Button x:Name="RunSetupAgainButton"
                                Grid.Column="1"
                                Content="重新设置"
                                Tag="&#xE72C;"
                                Style="{StaticResource SecondaryButton}"
                                VerticalAlignment="Top"
                                Click="RunSetupAgainButton_Click" />
                    </Grid>

                    <Border Grid.Row="1"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,20,0">
                                <TextBlock x:Name="LanguageSettingTitleText"
                                           Text="界面语言"
                                           FontWeight="SemiBold"
                                           FontSize="13" />
                                <TextBlock x:Name="LanguageSettingDescriptionText"
                                           Text="选择中文或英文。"
                                           Style="{StaticResource PageLeadStyle}"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Background="{DynamicResource SurfaceAltBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Padding="2"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="ChineseLanguageButton"
                                                 GroupName="Language"
                                                 Content="CHN"
                                                 Style="{StaticResource SegmentButtonStyle}"
                                                 IsEnabled="False"
                                                 Checked="ChineseLanguageButton_Checked" />
                                    <RadioButton x:Name="EnglishLanguageButton"
                                                 GroupName="Language"
                                                 Content="ENG"
                                                 Style="{StaticResource SegmentButtonStyle}"
                                                 IsEnabled="False"
                                                 Checked="EnglishLanguageButton_Checked" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,20,0">
                                <TextBlock x:Name="ThemeSettingTitleText"
                                           Text="外观"
                                           FontWeight="SemiBold"
                                           FontSize="13" />
                                <TextBlock x:Name="ThemeSettingDescriptionText"
                                           Text="选择浅色、深色或跟随 Windows。"
                                           Style="{StaticResource PageLeadStyle}"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Background="{DynamicResource SurfaceAltBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Padding="2"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="LightThemeButton"
                                                 GroupName="Theme"
                                                 Content="浅色"
                                                 Style="{StaticResource SegmentButtonStyle}"
                                                 IsEnabled="False"
                                                 Checked="LightThemeButton_Checked" />
                                    <RadioButton x:Name="DarkThemeButton"
                                                 GroupName="Theme"
                                                 Content="深色"
                                                 Style="{StaticResource SegmentButtonStyle}"
                                                 IsEnabled="False"
                                                 Checked="DarkThemeButton_Checked" />
                                    <RadioButton x:Name="SystemThemeButton"
                                                 GroupName="Theme"
                                                 Content="系统"
                                                 Style="{StaticResource SegmentButtonStyle}"
                                                 IsEnabled="False"
                                                 Checked="SystemThemeButton_Checked" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Row="3"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,20,0">
                                <TextBlock x:Name="RestartTitleText"
                                           Text="切换后自动重启 Codex"
                                           FontWeight="SemiBold"
                                           FontSize="13" />
                                <TextBlock x:Name="RestartDescriptionText"
                                           Text="重启会中断正在运行的 Codex 任务。配置写入前会自动生成备份。"
                                           Style="{StaticResource PageLeadStyle}"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                            <CheckBox x:Name="RestartCheckBox"
                                      Grid.Column="1"
                                      Style="{StaticResource SwitchStyle}"
                                      AutomationProperties.LabeledBy="{Binding ElementName=RestartTitleText}"
                                      VerticalAlignment="Center"
                                      Checked="RestartCheckBox_Changed"
                                      Unchecked="RestartCheckBox_Changed" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="4"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,20,0">
                                <TextBlock x:Name="LunaWorkerTitleText"
                                           Text="Luna 任务 Agent"
                                           FontWeight="SemiBold"
                                           FontSize="13" />
                                <TextBlock x:Name="LunaWorkerDescriptionText"
                                           Text="可选安装 Luna 任务 Agent；不切换线路或改动聊天记录。第三方线路需支持 gpt-5.6-luna。"
                                           Style="{StaticResource PageLeadStyle}"
                                           Margin="0,2,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <TextBlock x:Name="LunaWorkerStatusText"
                                           Text="正在检测…"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="11"
                                           HorizontalAlignment="Right"
                                           Margin="0,0,0,6"
                                           AutomationProperties.LiveSetting="Polite" />
                                <WrapPanel HorizontalAlignment="Right">
                                    <Button x:Name="InstallLunaWorkerButton"
                                            Content="安装 Luna Agent"
                                            Tag="&#xE896;"
                                            Style="{StaticResource SecondaryButton}"
                                            Margin="0,0,8,0"
                                            Click="InstallLunaWorkerButton_Click" />
                                    <Button x:Name="OpenLunaAgentsFolderButton"
                                            Content="打开 agents 文件夹"
                                            Tag="&#xE8B7;"
                                            Style="{StaticResource SecondaryButton}"
                                            Click="OpenLunaAgentsFolderButton_Click" />
                                </WrapPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="5" Margin="0,20,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="AboutTitleText"
                                   Text="关于"
                                   Style="{StaticResource SectionTitleStyle}" />
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,20,0">
                                <TextBlock x:Name="SettingsVersionText"
                                           Text="Codex Provider Switcher v1.3.3"
                                           FontWeight="SemiBold"
                                           FontSize="13" />
                                <TextBlock x:Name="SettingsStorageDescriptionText"
                                           Text="设置、诊断和备份保存在本机 LocalAppData。"
                                           Style="{StaticResource PageLeadStyle}"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                            <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                                <Button x:Name="OpenDataFolderButton"
                                        Content="打开数据目录"
                                        Tag="&#xE8B7;"
                                        Style="{StaticResource SecondaryButton}"
                                        Margin="0,0,8,8"
                                        Click="OpenDataFolderButton_Click" />
                                <Button x:Name="OpenGitHubButton"
                                        Content="GitHub"
                                        Tag="&#xE8A7;"
                                        Style="{StaticResource SecondaryButton}"
                                        Margin="0,0,0,8"
                                        Click="OpenGitHubButton_Click" />
                            </WrapPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </ScrollViewer>

            <Border Grid.Row="2"
                    Background="{DynamicResource StatusBarBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0">
                <Grid Margin="20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE946;"
                               FontFamily="{StaticResource IconFont}"
                               Foreground="{DynamicResource SubtleTextBrush}"
                               FontSize="12"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="OperationStatusText"
                               Grid.Column="1"
                               Text="就绪"
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="11"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               AutomationProperties.LiveSetting="Polite" />
                    <ProgressBar x:Name="BusyProgressBar"
                                 Grid.Column="2"
                                 Width="96"
                                 Height="3"
                                 IsIndeterminate="True"
                                 Visibility="Collapsed"
                                 VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
